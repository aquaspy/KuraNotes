<%
  total = @folder_counts.values.sum
  inbox = @folder_counts[""].to_i
  named = @folder_counts.except("").sort_by { |name, _| name }
%>
<div id="folders_nav" class="folder-strip" data-controller="confirm folders rename">
  <%= link_to notes_path(note_filters(folder: "all")), class: "folder-item #{"is-on" if @folder.blank? || @folder == "all"}" do %>
    <%= t("js.all") %> <em><%= total %></em>
  <% end %>

  <div class="folder-item <%= "is-on" if @folder == "inbox" %>">
    <%= link_to notes_path(note_filters(folder: "inbox")), class: "folder-item-link" do %>
      <%= t("js.inbox") %> <em><%= inbox %></em>
    <% end %>
    <% if inbox.positive? %>
      <button type="button" class="icon-btn danger folder-delete" data-action="confirm#open" data-url="<%= folder_notes_path(folder: "inbox") %>" data-message="<%= t("js.delete_inbox_confirm") %>" title="<%= t("app.clear_inbox") %>" aria-label="<%= t("app.clear_inbox") %>">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 4.4h9.6M6.2 4.4V3.2h3.6v1.2M5.1 6.2l.4 6.2h5l.4-6.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    <% end %>
  </div>

  <% named.each do |name, count| %>
    <div class="folder-item <%= "is-on" if @folder == name %>">
      <%= link_to notes_path(note_filters(folder: name)), class: "folder-item-link" do %>
        <%= name %> <em><%= count %></em>
      <% end %>
      <button type="button" class="icon-btn folder-rename" data-action="rename#open" data-from="<%= name %>" title="<%= t("app.rename_folder") %>" aria-label="<%= t("app.rename_folder") %>">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M11.4 2.9 13.1 4.6 5.6 12.1l-2.2.3.3-2.2Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" class="icon-btn danger folder-delete" data-action="confirm#open" data-url="<%= folder_notes_path(folder: name) %>" data-message="<%= t("js.delete_folder_confirm", name: name) %>" title="<%= t("app.delete_folder") %>" aria-label="<%= t("app.delete_folder") %>">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 4.4h9.6M6.2 4.4V3.2h3.6v1.2M5.1 6.2l.4 6.2h5l.4-6.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  <% end %>

  <dialog class="confirm-dialog" data-confirm-target="box" data-action="click->confirm#backdrop">
    <p data-confirm-target="message"><%= t("js.delete_folder_confirm", name: "") %></p>
    <div class="confirm-actions">
      <button type="button" class="btn-dialog" data-action="confirm#close"><%= t("app.cancel") %></button>
      <%= link_to t("app.delete"), notes_path, class: "btn-dialog danger", data: { confirm_target: "destroy", turbo_method: :delete } %>
    </div>
  </dialog>

  <dialog class="confirm-dialog" data-rename-target="box" data-action="click->rename#backdrop close->rename#closed">
    <p><%= t("app.rename_folder") %></p>
    <%= form_with url: folder_notes_path, method: :patch do %>
      <%= hidden_field_tag :folder, "", id: "rename_folder_from", data: { rename_target: "from" } %>
      <%= hidden_field_tag :q, params[:q] if params[:q].present? %>
      <%= text_field_tag :name, "", id: "rename_folder_name", maxlength: Note::FOLDER_MAX_LENGTH, required: true, autocomplete: "off", class: "rename-input", data: { rename_target: "input" } %>
      <div class="confirm-actions">
        <button type="button" class="btn-dialog" data-action="rename#close"><%= t("app.cancel") %></button>
        <button type="submit" class="btn-dialog primary"><%= t("app.rename") %></button>
      </div>
    <% end %>
  </dialog>
</div>
