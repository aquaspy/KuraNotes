<div class="io-actions">
  <%= link_to export_notes_path, class: "btn-io" do %>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v8M5 8.2 8 11.2 11 8.2M3 13.2h10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span><%= t("app.export") %></span>
  <% end %>
  <%= form_with url: import_notes_path, class: "import-form", multipart: true do |f| %>
    <label class="btn-io">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13.2V5.2M5 8.2 8 5.2 11 8.2M3 2.8h10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span><%= t("app.import") %></span>
      <%= f.file_field :file, multiple: true, include_hidden: false, accept: ".json,.txt,.zip,text/plain,application/json,application/zip", class: "sr-only", onchange: "this.form.requestSubmit()" %>
    </label>
  <% end %>
</div>
