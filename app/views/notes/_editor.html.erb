<% if @note %>
  <div class="editor-wrap" data-controller="share" data-share-copied-value="<%= t("app.copied") %>">
    <%= form_with model: @note, class: "editor-form", data: { controller: "autosave confirm", autosave_saved_value: t("js.saved"), autosave_saving_value: t("js.saving"), autosave_offline_value: t("js.offline"), action: "input->autosave#queue turbo:submit-end->autosave#done" } do |form| %>
      <%= hidden_field_tag :folder, params[:folder] if params[:folder].present? %>
      <%= hidden_field_tag :q, params[:q] if params[:q].present? %>
      <header class="editor-bar">
        <%= link_to notes_path(note_filters), class: "icon-btn back", title: t("app.notes"), aria: { label: t("app.notes") } do %>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <% end %>
        <button type="button" class="icon-btn desktop-only" data-action="layout#toggleFolders" title="<%= t("app.folders") %>" aria-label="<%= t("app.folders") %>">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12M2 8h12M2 12.5h12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        </button>
        <button type="button" class="icon-btn desktop-only" data-action="layout#toggleList" title="<%= t("app.list") %>" aria-label="<%= t("app.list") %>">
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="2.5" width="4" height="11" rx="0.8" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M9 4.5h4.5M9 8h4.5M9 11.5h4.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        </button>
        <button type="button" class="icon-btn desktop-only" data-action="layout#toggleFocus" title="<%= t("app.focus") %>" aria-label="<%= t("app.focus") %>">
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="3" width="10" height="10" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M6 8h4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        </button>
        <button type="button" class="icon-btn" data-action="theme#cycle" data-theme-button title="<%= t("auth.theme") %>" aria-label="<%= t("auth.theme") %>">
          <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M8 3a5 5 0 0 0 0 10Z" fill="currentColor"/></svg>
        </button>
        <div class="folder-picker" data-controller="folder-picker">
          <%= form.text_field :folder, placeholder: t("app.folder"), class: "folder-input", autocomplete: "off", maxlength: Note::FOLDER_MAX_LENGTH, role: "combobox", aria: { autocomplete: "list", expanded: "false", controls: "folder_picker_list" }, data: { folder_picker_target: "input", action: "focus->folder-picker#open input->folder-picker#filter keydown->folder-picker#keydown" } %>
          <button type="button" class="folder-picker-toggle" data-action="pointerdown->folder-picker#toggle" title="<%= t("app.choose_folder") %>" aria-label="<%= t("app.choose_folder") %>" tabindex="-1">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 6.2 8 9.8l3.5-3.6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div id="folder_picker_list" class="folder-picker-list" data-folder-picker-target="list" hidden role="listbox">
            <%= render "folder_picker_options" %>
          </div>
        </div>
        <span class="bar-spacer desktop-only"></span>
        <span class="status" data-autosave-target="status"></span>
        <button type="button" class="icon-btn" data-action="lock#lock" title="<%= t("app.lock") %>" aria-label="<%= t("app.lock") %>">
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.4" y="7.2" width="9.2" height="6.4" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M5.3 7.2V5.4a2.7 2.7 0 0 1 5.4 0v1.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        </button>
        <%= render "share_button", note: @note %>
        <button type="button" class="icon-btn danger" data-action="confirm#open" title="<%= t("app.delete") %>" aria-label="<%= t("app.delete") %>">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 4.4h9.6M6.2 4.4V3.2h3.6v1.2M5.1 6.2l.4 6.2h5l.4-6.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </header>
      <%= form.text_area :body, class: "note-body", placeholder: t("app.write_placeholder"), spellcheck: true %>
      <dialog class="confirm-dialog" data-confirm-target="box" data-action="click->confirm#backdrop">
        <p><%= t("js.delete_confirm") %></p>
        <div class="confirm-actions">
          <button type="button" class="btn-dialog" data-action="confirm#close"><%= t("app.cancel") %></button>
          <%= link_to t("app.delete"), note_path(@note, note_filters), class: "btn-dialog danger", data: { turbo_method: :delete } %>
        </div>
      </dialog>
    <% end %>

    <dialog class="confirm-dialog share-dialog" data-share-target="box" data-action="click->share#backdrop">
      <p class="share-heading"><%= t("app.share") %></p>
      <%= render "share_panel", note: @note %>
    </dialog>
  </div>
<% else %>
  <p class="empty-editor"><%= t("app.empty_editor") %></p>
<% end %>
