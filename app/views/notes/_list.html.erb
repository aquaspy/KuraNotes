<div id="notes_list" class="note-list" data-controller="confirm">
  <% if @notes.empty? %>
    <p class="muted empty-list"><%= t("js.empty_list") %></p>
  <% else %>
    <% @notes.each do |note| %>
      <div class="note-item #{"is-on" if @note&.id == note.id}">
        <%= link_to note_path(note, note_filters), class: "note-item-link" do %>
          <strong><%= note.title.presence || t("js.untitled") %></strong>
          <span><%= note.preview %></span>
        <% end %>
        <button type="button" class="icon-btn danger note-delete" data-action="confirm#open" data-url="<%= note_path(note, note_filters) %>" title="<%= t("app.delete") %>" aria-label="<%= t("app.delete") %>">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 4.4h9.6M6.2 4.4V3.2h3.6v1.2M5.1 6.2l.4 6.2h5l.4-6.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    <% end %>
    <dialog class="confirm-dialog" data-confirm-target="box" data-action="click->confirm#backdrop">
      <p><%= t("js.delete_confirm") %></p>
      <div class="confirm-actions">
        <button type="button" class="btn-dialog" data-action="confirm#close"><%= t("app.cancel") %></button>
        <%= link_to t("app.delete"), notes_path, class: "btn-dialog danger", data: { confirm_target: "destroy", turbo_method: :delete } %>
      </div>
    </dialog>
  <% end %>
</div>
