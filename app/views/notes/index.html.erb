<% content_for :title, t("titles.app") %>

<%= button_to "", lock_path, method: :post, id: "lock-now", class: "sr-only", tabindex: -1, form: { id: "lock-now-form" } %>
<% if notice %><p class="flash flash-notice" role="status"><%= notice %></p><% end %>
<% if alert %><p class="flash flash-alert" role="alert"><%= alert %></p><% end %>
<div class="app-shell <%= "is-editing" if @note %>" data-controller="layout lock offline" data-lock-enabled-value="<%= current_user.auto_lock? %>">
  <p class="offline-banner" data-offline-target="banner" hidden><%= t("app.offline") %></p>

  <header class="mobile-top">
    <%= render "shared/wordmark" %>
    <button type="button" class="icon-btn" data-action="theme#cycle" data-theme-button title="<%= t("auth.theme") %>" aria-label="<%= t("auth.theme") %>">
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M8 3a5 5 0 0 0 0 10Z" fill="currentColor"/></svg>
    </button>
    <button type="button" class="icon-btn" data-action="lock#lock" title="<%= t("app.lock") %>" aria-label="<%= t("app.lock") %>">
      <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.4" y="7.2" width="9.2" height="6.4" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M5.3 7.2V5.4a2.7 2.7 0 0 1 5.4 0v1.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
    </button>
    <button type="button" class="icon-btn" data-action="layout#toggleMenu" data-layout-target="menuButton" title="<%= t("app.more") %>" aria-label="<%= t("app.more") %>" aria-expanded="false">
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="3.5" r="1.1" fill="currentColor"/><circle cx="8" cy="8" r="1.1" fill="currentColor"/><circle cx="8" cy="12.5" r="1.1" fill="currentColor"/></svg>
    </button>
    <div class="mobile-menu" data-layout-target="menu" hidden>
      <%= render "transfer" %>
      <%= button_to lock_path, method: :post, class: "btn-io" do %>
        <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.4" y="7.2" width="9.2" height="6.4" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M5.3 7.2V5.4a2.7 2.7 0 0 1 5.4 0v1.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        <span><%= t("app.lock") %></span>
      <% end %>
      <%= render "auto_lock_button" %>
      <%= render "change_password_button" %>
      <%= render "shared/sign_out" %>
    </div>
  </header>

  <aside class="col-folders">
    <div class="brand">
      <%= render "shared/wordmark" %>
    </div>
    <nav class="folder-list">
      <%= render "folders" %>
    </nav>
    <div class="sidebar-foot desktop-only">
      <%= render "transfer" %>
      <%= button_to lock_path, method: :post, class: "btn-io" do %>
        <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.4" y="7.2" width="9.2" height="6.4" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M5.3 7.2V5.4a2.7 2.7 0 0 1 5.4 0v1.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        <span><%= t("app.lock") %></span>
      <% end %>
      <%= render "auto_lock_button" %>
      <%= render "change_password_button" %>
      <%= render "shared/sign_out" %>
    </div>
  </aside>

  <section class="col-list">
    <div class="list-head">
      <%= button_to notes_path(note_filters), class: "btn-new", form: { class: "desktop-only" } do %>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span><%= t("app.new_note") %></span>
      <% end %>
      <%= form_with url: notes_path, method: :get, class: "search-form", data: { controller: "search", turbo_frame: "note-search", action: "input->search#query submit->search#flush" } do %>
        <%= hidden_field_tag :folder, params[:folder] if params[:folder].present? %>
        <%= search_field_tag :q, @query, placeholder: t("app.search"), class: "search", enterkeyhint: "search", autocomplete: "off" %>
      <% end %>
    </div>
    <%= turbo_frame_tag "note-search" do %>
      <%= render "list" %>
    <% end %>
  </section>

  <section class="col-editor">
    <%= render "editor" %>
  </section>

  <%= button_to notes_path(note_filters), class: "fab", form: { class: "fab-form" }, aria: { label: t("app.new_note") } do %>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
  <% end %>
</div>
