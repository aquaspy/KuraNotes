# Copy to .env and fill in. Then:
#   docker compose up -d --build
# After editing .env, apply with:
#   docker compose up -d
# (compose restart keeps the old env; up -d recreates the container.)

# Pick one. SECRET_KEY_BASE is enough for Compose.
#   openssl rand -hex 64
SECRET_KEY_BASE=

# Optional. Only if you use Rails credentials instead of SECRET_KEY_BASE.
# From config/master.key after: EDITOR=true bin/rails credentials:edit
# A random value will not decrypt the credentials.yml.enc in git.
RAILS_MASTER_KEY=

# Public signup form. true for the first account, then flip to false.
SIGNUP_ENABLED=true

# Set true when your own Caddy/nginx terminates HTTPS in front.
FORCE_SSL=false

# Your public hostname. Comma-separated if you have more than one.
# Leave empty only while testing. Share links use the request host.
KURA_HOST=notes.example.com

# Publish only on localhost so 80/443 stay free for your proxy.
# Point Caddy or nginx at 127.0.0.1:3000.
BIND=127.0.0.1:3000
